<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://www.ehcache.org/v3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd">

    <cache-template name="entity-defaults">
        <expiry><ttl unit="minutes">30</ttl></expiry>
        <heap unit="entries">500</heap>
    </cache-template>

    <!-- Categories: мало записей, редко меняются -->
    <cache alias="com.montblanc.montblanc.Clases.Categories" uses-template="entity-defaults">
        <expiry><ttl unit="minutes">60</ttl></expiry>
        <heap unit="entries">100</heap>
    </cache>

    <!-- Products: кэш с TTL 10 мин -->
    <cache alias="com.montblanc.montblanc.Clases.Product" uses-template="entity-defaults">
        <expiry><ttl unit="minutes">10</ttl></expiry>
        <heap unit="entries">1000</heap>
    </cache>
</config>
